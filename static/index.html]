<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Readmission Risk</title>
  <link rel="stylesheet" href="/static/style.css">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:wght@600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap">
</head>
<body>
<main>
  <div class="theme" role="group" aria-label="Theme">
    <button type="button" data-theme-choice="light">Light</button>
    <button type="button" data-theme-choice="system">System</button>
    <button type="button" data-theme-choice="dark">Dark</button>
  </div>
  <h1>30-day readmission risk</h1>
  <p id="status">Loading model schema…</p>

  <nav class="steps" id="steps">
    <span class="step is-active" data-step="1"><b>1</b> Encounter</span>
    <span class="step" data-step="2"><b>2</b> Patient</span>
    <span class="step" data-step="3"><b>3</b> Result</span>
  </nav>
  <div class="progress"><div class="progress-bar" id="progress"></div></div>

  <form id="form">
    <section class="panel" data-panel="1">
      <fieldset>
        <legend>Encounter</legend>
        <div id="numeric" class="grid"></div>
      </fieldset>
      <div class="actions">
        <span></span>
        <button type="button" data-next>Next: patient →</button>
      </div>
    </section>

    <section class="panel" data-panel="2">
      <fieldset>
        <legend>Patient &amp; clinical</legend>
        <div id="categorical" class="grid"></div>
      </fieldset>
      <div class="actions">
        <button type="button" class="ghost" data-back>← Back</button>
        <button type="submit">Predict →</button>
      </div>
    </section>

    <section class="panel" data-panel="3">
      <div id="result"></div>
      <div class="actions">
        <button type="button" class="ghost" data-back>← Edit patient</button>
        <button type="button" data-restart>Start over</button>
      </div>
    </section>
  </form>
</main>

  <script>
    // Fields where "not recorded" is a real, meaningful state in the data.
    // Sending null lets the pipeline's imputer map it to the MISSING category,
    // the same way it was handled in training.
    const NULLABLE = new Set(["race", "A1Cresult", "max_glu_serum"]);

    const label = (name) => name.replaceAll("_", " ");
    const pct = (p) => (p * 100).toFixed(1) + "%";

    function numericField(name, info) {
      const wrap = document.createElement("label");
      wrap.textContent = label(name);
      const input = document.createElement("input");
      input.type = "number";
      input.name = name;
      input.min = info.min;
      input.max = info.max;
      input.step = 1;
      input.value = info.median;
      input.required = true;
      wrap.appendChild(input);
      return wrap;
    }

    function categoricalField(name, info) {
      const wrap = document.createElement("label");
      wrap.textContent = label(name);
      const select = document.createElement("select");
      select.name = name;
      if (NULLABLE.has(name)) {
        select.add(new Option("Not recorded", ""));
      }
      // ID codes arrive sorted as strings ("1", "10", "11", "2"); show them in numeric order.
      const options = [...info.options];
      if (options.every(o => !isNaN(o))) options.sort((a, b) => a - b);
      for (const opt of options) {
        select.add(new Option(opt, opt, false, opt === info.default));
      }
      wrap.appendChild(select);
      return wrap;
    }

    function buildForm(schema) {
      const num = document.getElementById("numeric");
      const cat = document.getElementById("categorical");
      for (const [name, info] of Object.entries(schema.numeric)) {
        num.appendChild(numericField(name, info));
      }
      for (const [name, info] of Object.entries(schema.categorical)) {
        cat.appendChild(categoricalField(name, info));
      }
    }

    function readForm(form) {
      const features = {};
      for (const el of form.elements) {
        if (!el.name) continue;
        if (el.type === "number") {
          features[el.name] = Number(el.value);
        } else {
          features[el.name] = el.value === "" ? null : el.value;
        }
      }
      return features;
    }

    function render(data) {
      const out = document.getElementById("result");
      const caveats = data.caveats.length
        ? `<div class="caveats">
             <h3>⚠ Known limitations for this patient</h3>
             ${data.caveats.map(c => `<p>${c}</p>`).join("")}
             <p><strong>Do not rely on this score.</strong></p>
           </div>`
        : "";
      out.innerHTML = `
        <div class="card">
          <div class="hero">${pct(data.probability)}</div>
          <div class="compare">
            predicted 30-day readmission risk ·
            ${data.lift_vs_baseline}× the ${pct(data.baseline_rate)} baseline
          </div>
          <span class="band band-${data.band}">${data.band} risk</span>
          ${caveats}
        </div>`;
    }

    async function predict(event) {
      event.preventDefault();
      const features = readForm(event.target);
      const res = await fetch("/predict", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ features }),
      });
      const data = await res.json();
      if (!res.ok) {
        document.getElementById("result").innerHTML =
          `<p class="error">Error ${res.status}: ${data.detail}</p>`;
        return;
      }
      render(data);
    }

    async function main() {
      const schema = await fetch("/schema").then(r => r.json());
      const meta = await fetch("/metadata").then(r => r.json());

      const nNum = Object.keys(schema.numeric).length;
      const nCat = Object.keys(schema.categorical).length;
      document.getElementById("status").textContent =
        `Gradient boosting · 5-fold GroupKFold PR-AUC ${meta.cv_pr_auc.toFixed(3)} · ` +
        `${nNum} numeric + ${nCat} categorical inputs`;

      buildForm(schema);
      document.getElementById("form").addEventListener("submit", predict);
    }

    // Theme: "system" leaves it to the OS; "light"/"dark" force it via color-scheme.
    function applyTheme(mode) {
      if (mode === "system") delete document.documentElement.dataset.theme;
      else document.documentElement.dataset.theme = mode;
      for (const b of document.querySelectorAll("[data-theme-choice]")) {
        b.classList.toggle("is-active", b.dataset.themeChoice === mode);
      }
      try { localStorage.setItem("theme", mode); } catch {}
    }
    let savedTheme = "system";
    try { savedTheme = localStorage.getItem("theme") || "system"; } catch {}
    applyTheme(savedTheme);
    for (const b of document.querySelectorAll("[data-theme-choice]")) {
      b.addEventListener("click", () => applyTheme(b.dataset.themeChoice));
    }

    main().catch(err => {
      document.getElementById("status").textContent = "Failed to load: " + err;
    });
  </script>
</</html>
     // Wizard: show one panel at a time; keep the tabs and progress bar in sync.
    let currentStep = 1;
    function goTo(step) {
      currentStep = step;
      for (const p of document.querySelectorAll(".panel")) {
        p.hidden = Number(p.dataset.panel) !== step;
      }
      for (const s of document.querySelectorAll(".step")) {
        const n = Number(s.dataset.step);
        s.classList.toggle("is-active", n === step);
        s.classList.toggle("is-done", n < step);
      }
      document.getElementById("progress").style.width = (step / 3 * 100) + "%";
      window.scrollTo({ top: 0, behavior: "smooth" });
    }
    function panelIsValid(step) {
      const fields = document.querySelectorAll(`.panel[data-panel="${step}"] :is(input, select)`);
      for (const el of fields) if (!el.reportValidity()) return false;
      return true;
    }
    document.querySelector("[data-next]").addEventListener("click", () => {
      if (panelIsValid(1)) goTo(2);
    });
    for (const b of document.querySelectorAll("[data-back]")) {
      b.addEventListener("click", () => goTo(currentStep - 1));
    }
    document.querySelector("[data-restart]").addEventListener("click", () => location.reload());
    goTo(1);
